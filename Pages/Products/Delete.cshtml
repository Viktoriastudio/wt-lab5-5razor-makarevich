@page
@model wt_lab8_8razor_postgresql_makarevich.Pages.Products.DeleteModel
<h1>Удалить товар</h1>
<h3>Вы уверены, что хотите удалить этот товар?</h3>
<div>
    <p><strong>Название:</strong> @Model.Product.Name</p>
    <p><strong>Категория:</strong> @Model.Product.Category</p>
    <p><strong>Цена:</strong> @Model.Product.Price</p>
    <form method="post">
        <input type="hidden" asp-for="Product.Id" />
        <button type="submit" class="btn btn-danger">Удалить</button> |
        <a asp-page="./Index">Назад к списку</a>
    </form>
</div>