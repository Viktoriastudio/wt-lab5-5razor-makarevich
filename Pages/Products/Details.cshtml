@model wt_lab8_8razor_postgresql_makarevich.Pages.Products.DetailsModel
<h1>Детали товара</h1>
<div>
    <p><strong>Название:</strong> @Model.Product.Name</p>
    <p><strong>Категория:</strong> @Model.Product.Category</p>
    <p><strong>Цена:</strong> @Model.Product.Price</p>
    <p><strong>Доступен:</strong> @(Model.Product.IsAvailable ? "Да" : "Нет")</p>
</div>
