@page
@model wt_lab8_8razor_postgresql_makarevich.Pages.Products.EditModel
<h1>Редактировать товар</h1>
<form method="post">
    <input type="hidden" asp-for="Product.Id" />
    <div class="mb-3"><label>Название</label><input asp-for="Product.Name" class="form-control" /></div>
    <div class="mb-3"><label>Категория</label><input asp-for="Product.Category" class="form-control" /></div>
    <div class="mb-3"><label>Цена</label><input asp-for="Product.Price" class="form-control" /></div>
    <div class="mb-3"><label>Доступен</label><input asp-for="Product.IsAvailable" type="checkbox" /></div>
    <div class="mb-3">
    <label>Описание</label>
    <input asp-for="Product.Description" class="form-control" />
</div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="./Index">Назад к списку</a>
</form>