@page
@model wt_lab5_5razor_makarevich.Pages.Products.IndexModel

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог задач</h1>
            <p class="text-muted">Система управления IT-проектами</p>
        </div>
        <a asp-page="/Products/Create" class="btn btn-primary">Добавить задачу</a>
    </div>

    <div class="row g-4">
        @foreach (var task in Model.Tasks)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2">ID: @task.Id</span>
                        <h5 class="card-title">@task.Title</h5>
                        <p class="mb-1"><strong>Проект:</strong> @task.Project</p>
                        <p class="mb-1"><strong>Исполнитель:</strong> @task.Assignee</p>
                        <p class="mb-1"><strong>Часы:</strong> @task.EstimatedHours</p>
                        <p class="mb-3">
                            <span class="badge @(task.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                @(task.IsCompleted ? "Завершена" : "В работе")
                            </span>
                        </p>
                        <div class="mt-auto">
                            <a asp-page="/Products/Details" asp-route-id="@task.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-page="/Products/Edit" asp-route-id="@task.Id" class="btn btn-outline-secondary btn-sm">Изменить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>