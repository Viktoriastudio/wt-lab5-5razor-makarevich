@page
@model wt_lab8_8razor_postgresql_makarevich.Pages.Products.IndexModel
<h1>Товары</h1>

<form method="get" class="mb-3">
    <input type="text" name="Search" value="@Model.Search" placeholder="Название товара">
    <button type="submit" class="btn btn-primary">Найти</button>
</form>

<a asp-page="./Create" class="btn btn-success mb-3">Добавить товар</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th><th>Название</th><th>Категория</th><th>Цена</th><th>Доступность</th><th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Category</td>
                <td>@product.Price</td>
                <td>@(product.IsAvailable ? "Да" : "Нет")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@product.Id">Редактировать</a> |
                    <a asp-page="./Delete" asp-route-id="@product.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>